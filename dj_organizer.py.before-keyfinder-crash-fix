            item = QTreeWidgetItem([
                f"💿 {name}"
            ])

            item.setData(
                0,
                Qt.UserRole,
                str(root_path)
            )

            item.setData(
                0,
                Qt.UserRole + 1,
                "library"
            )

            self.tree.addTopLevelItem(
                item
            )

            self.build_tree(
                item,
                root_path
            )

            if not root_path.exists():

                item.setText(
                    0,
                    f"💿 {name} [відключено]"
                )


    def build_tree(
        self,
        parent_item,
        root
    ):

        folders = set()

        if not root.exists():
            return

        try:

            for path in root.rglob("*"):

                if path.is_dir():

                    try:

                        relative = path.relative_to(
                            root
                        )

                    except Exception:

                        continue

                    if relative.parts:
                        folders.add(
                            relative
                        )

        except Exception:

            return

        items = {}

        for relative in sorted(
            folders,
            key=lambda x: (
                len(x.parts),
                str(x).lower()
            )
        ):

            parent = parent_item

            current = Path()

            for part in relative.parts:

                current = (
                    current / part
                )

                key = str(
                    current
                )

                if key not in items:

                    child = QTreeWidgetItem([
                        f"📁 {part}"
                    ])

                    full_path = (
                        root / current
                    )

                    child.setData(
                        0,
                        Qt.UserRole,
                        str(full_path)
                    )

                    child.setData(
                        0,
                        Qt.UserRole + 1,
                        "folder"
                    )

                    parent.addChild(
                        child
                    )

                    items[key] = child

                parent = items[key]


