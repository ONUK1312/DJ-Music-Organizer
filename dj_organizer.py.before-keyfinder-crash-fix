    # SHOW TRACKS
    # ========================================================

    def show_folder_tracks(self):

        if not self.current_folder:
            return

        selected = (
            self.current_folder.resolve()
        )

        library_root = (
            self.current_library_root
        )

        if not library_root:
            return

        # ====================================================
        # ГОЛОВНЕ ВИПРАВЛЕННЯ
        #
        # НЕ БЕРЕМО СПИСОК ТРЕКІВ ІЗ БАЗИ.
        #
        # Спочатку отримуємо фізичні файли з диска.
        # ====================================================

        if not selected.exists():

            self.clear_table()

            return

        real_files = find_audio_files(
            selected
        )

        # ====================================================
        # Для кожного РЕАЛЬНОГО файлу беремо кеш.
        # Старі записи, яких нема на диску, ігноруються.
        # ====================================================

        rows = []

        for path in real_files:

            saved = get_track(
                path
            )

            fp = fingerprint(
                path
            )

            # ------------------------------------------------
            # Кеш правильний тільки якщо:
            #
            # 1. файл той самий
            # 2. fingerprint той самий
            # 3. library_root той самий
            # ------------------------------------------------

            if (
                saved
                and saved[2] == fp
                and len(saved) > 10
                and saved[10]
                and Path(saved[10]).resolve()
                == library_root
            ):

                artist = (
                    saved[3]
                    or "Unknown Artist"
                )

                title = (
                    saved[4]
                    or path.stem
                )

                bpm = (
                    saved[5]
                    or ""
                )

                key = (
                    saved[6]
                    or ""
                )

                category = (
                    saved[7]
                    or "Uncategorized"
                )

                try:

                    relative_dir = str(
                        path.parent.relative_to(
                            library_root
                        )
                    )

                except Exception:

                    relative_dir = ""

            else:

                # Новий файл, якого ще немає
                # або його fingerprint змінився.
                #
                # Поки не аналізували —
                # показуємо метадані,
                # BPM/Key залишаємо порожніми.

                artist, title = metadata(
                    path
                )

                bpm = ""

                key = ""

                try:

                    relative = path.relative_to(
                        library_root
                    )

                    relative_dir = str(
                        relative.parent
                    )

                    if relative_dir == ".":
                        category = "Root"
                    else:
                        category = relative.parts[0]

                except Exception:

                    relative_dir = ""

                    category = "Uncategorized"

            data = {

                "path": path,

                "root":
                    library_root,

                "fingerprint":
                    fp,

                "artist":
                    artist,

                "title":
                    title,

                "bpm":
                    bpm,

                "key":
                    key,

                "category":
                    category,

                "extension":
                    path.suffix,

                "modified":
                    path.stat().st_mtime,

                "relative_dir":
                    relative_dir,
            }

            rows.append(
                data
            )

        # ====================================================
        # СОРТУВАННЯ
        # ====================================================

        rows.sort(
            key=lambda x: (
                x["artist"].lower(),
                x["title"].lower()
            )
        )

        self.table.blockSignals(
            True
        )

        self.table.setRowCount(
            0
        )

        self.rows = []

        for data in rows:

            self.rows.append(
                data
            )

            self.add_table_row(
                data
            )

        self.table.blockSignals(
            False
        )

        self.update_names()

        self.apply_button.setEnabled(
            bool(self.rows)
        )

        self.filter_table()


    def clear_table(self):

        self.table.blockSignals(
            True
        )

        self.table.setRowCount(
            0
        )

        self.table.blockSignals(
            False
        )

        self.rows = []

        self.apply_button.setEnabled(
            False
        )


    # ========================================================
    # TABLE
    # ========================================================

    def add_table_row(
        self,
        data
    ):

        row = self.table.rowCount()

        self.table.insertRow(
            row
        )

        values = [
            Path(data["path"]).name,
            data["artist"],
            data["title"],
            data["bpm"],
            data["key"],
            data["category"],
            "",
        ]

        for col, value in enumerate(
            values
        ):

            self.table.setItem(
                row,
                col,
                QTableWidgetItem(
                    str(value)
                )
            )

        # Artist / Title / Genre
        for col in (
            1,
            2,
            5
        ):

            item = self.table.item(
                row,
                col
            )

            item.setFlags(
                Qt.ItemIsSelectable
                |
                Qt.ItemIsEnabled
                |
                Qt.ItemIsEditable
            )


    # ========================================================
    # EDITED CELL
    # ========================================================

    def cell_changed(
        self,
        item
    ):

        row = item.row()

        col = item.column()

        if row >= len(
            self.rows
        ):
            return

        if col not in (
            1,
            2,
            5
        ):
            return

        data = self.rows[
            row
        ]

        artist = self.table.item(
            row,
            1
        ).text()

        title = self.table.item(
            row,
            2
        ).text()

        category = self.table.item(
            row,
            5
        ).text()

        data["artist"] = artist

        data["title"] = title

        data["category"] = category

        try:

            modified = data[
                "path"
            ].stat().st_mtime

        except Exception:

            modified = data.get(
                "modified",
                0
            )

        save_track({
            **data,

            "extension":
                data["path"].suffix,

            "modified":
                modified,
        })

        self.update_row_name(
            row
        )


    # ========================================================
    # NAME
    # ========================================================

    def update_row_name(
        self,
        row
    ):

        if row >= len(
            self.rows
        ):
            return

        data = self.rows[
            row
        ]

        artist = self.table.item(
            row,
            1
        ).text()

        title = self.table.item(
            row,
            2
        ).text()

        category = self.table.item(
            row,
            5
        ).text()

        values = {

            "bpm":
                data["bpm"]
                or "BPM?",

            "key":
                data["key"]
                or "KEY?",

            "artist":
                clean_filename(
                    artist
                ),

            "title":
                clean_filename(
                    title
                ),

            "category":
                clean_filename(
                    category
                ),
        }

        try:

            name = self.pattern.text().format(
                **values
            )

        except Exception:

            name = "Неправильний формат"

        name = (
            clean_filename(name)
            +
            Path(
                data["path"]
            ).suffix
        )

        self.table.blockSignals(
            True
        )

        self.table.setItem(
            row,
            6,
            QTableWidgetItem(
                name
            )
        )

        self.table.blockSignals(
            False
        )


    def update_names(self):

        for row in range(
            self.table.rowCount()
        ):

            self.update_row_name(
                row
            )


    # ========================================================
    # SEARCH
    # ========================================================

    def filter_table(self):

        text = (
            self.search.text()
            .lower()
            .strip()
        )

        for row in range(
            self.table.rowCount()
        ):

            values = []

            for col in range(7):

                item = self.table.item(
                    row,
                    col
                )

                if item:

                    values.append(
                        item.text().lower()
                    )

            visible = (
                text in
                " ".join(values)
            )

            self.table.setRowHidden(
                row,
                not visible
            )


    # ========================================================
    # SCAN
    # ========================================================

    def scan_current(self):

        if not self.current_folder:
            return

        if not self.current_folder.exists():

            QMessageBox.warning(
                self,
                "Флешка відключена",
                "Ця папка зараз недоступна."
            )

            return

        # ----------------------------------------------------
        # Завжди скануємо в межах ROOT БІБЛІОТЕКИ.
        #
        # Це важливо:
        # якщо вибрано Techno, ми не робимо Techno
        # новою бібліотекою.
        # ----------------------------------------------------

        root = (
            self.current_library_root
        )

        if not root:
            root = get_library_root_for_path(
                self.current_folder
            )

        if not root:
            QMessageBox.warning(
                self,
                "Помилка",
                "Не вдалося визначити бібліотеку."
            )

            return

        self.start_scan(
            root
        )


    def start_scan(
        self,
        root
    ):

        root = Path(
            root
        ).resolve()

        if not root.exists():

            QMessageBox.warning(
                self,
                "Флешка відключена",
                "Ця папка зараз недоступна."
            )

            return

        files = find_audio_files(
            root
        )

        if not files:

            QMessageBox.information(
                self,
                "Немає музики",
                "У цій папці немає аудіофайлів."
            )

            return

        self.progress.setValue(
            0
        )

        self.analyzer = Analyzer(
            root,
            files
        )

        self.analyzer.progress.connect(
            self.progress.setValue
        )

        self.analyzer.track.connect(
            self.scanned_track
        )

        self.analyzer.finished_all.connect(
            self.scan_finished
        )

        self.scan_button.setEnabled(
            False
        )

        if hasattr(self, 'exact_scan_button'):
            self.exact_scan_button.setEnabled(
                False
            )

        self.analyzer.start()


    def scanned_track(self, data):
        """
        Оновлюємо таблицю після аналізу одного треку.
        """

        if self.current_folder is None:
            return

        path = Path(data["path"]).resolve()

        try:
            path.relative_to(
                self.current_folder.resolve()
            )
        except ValueError:
            return

        try:
            self.show_folder_tracks()
        except Exception as e:
            print(
                f"ПОМИЛКА оновлення таблиці для "
                f"{path.name}: {e}"
            )

    def scan_finished(self):

        self.scan_button.setEnabled(
            True
        )

        if hasattr(self, 'exact_scan_button'):
            self.exact_scan_button.setEnabled(
                True
            )

        # Оновлюємо дерево.
        self.load_libraries()

        # ВАЖЛИВО:
        # показуємо тільки фізичні файли.
        if self.current_folder:

            self.show_folder_tracks()

        QMessageBox.information(
            self,
            "Готово",
            "Сканування завершено.\n\n"
            "Для незмінених файлів використано кеш."
        )


    # ========================================================
    # APPLY
    # ========================================================

    def apply_changes(self):

        if not self.rows:
            return

        renamed = 0

        errors = []

        for row in range(
            self.table.rowCount()
        ):

            if self.table.isRowHidden(
                row
            ):
                continue

            if row >= len(
                self.rows
            ):
                continue

            data = self.rows[
                row
            ]

            old_path = Path(
                data["path"]
            )

            if not old_path.exists():

                errors.append(
                    f"{old_path.name}: файл не існує"
                )

                continue

            item = self.table.item(
                row,
                6
            )

            if not item:
                continue

            new_name = item.text().strip()

            if not new_name:
                continue

            new_name = clean_filename(
                new_name
            )

            if not new_name:
                continue

            new_path = (
                old_path.parent
                /
                new_name
            )

            # ------------------------------------------------
            # Якщо назва та сама
            # ------------------------------------------------

            if new_path.resolve() == old_path.resolve():

                continue

            # ------------------------------------------------
            # ЗАХИСТ ВІД ПЕРЕЗАПИСУ
            # ------------------------------------------------

            if new_path.exists():

                stem = new_path.stem

                suffix = new_path.suffix

                counter = 1

                while True:

                    candidate = (
                        old_path.parent
                        /
                        f"{stem} ({counter}){suffix}"
                    )

                    if not candidate.exists():

                        new_path = candidate

                        break

                    counter += 1

            # ------------------------------------------------
            # RENAME
            # ------------------------------------------------

            try:

                old_path.rename(
                    new_path
                )

                renamed += 1

                # ------------------------------------------------
                # Оновлюємо дані в пам'яті
                # ------------------------------------------------

                data["path"] = (
                    new_path.resolve()
                )

                data["fingerprint"] = (
                    fingerprint(
                        new_path
                    )
                )

                try:

                    data["modified"] = (
                        new_path.stat().st_mtime
                    )

                except Exception:

                    data["modified"] = 0

                # ------------------------------------------------
                # Оновлюємо SQLite
                # ------------------------------------------------

                con = db()

                con.execute(
                    """
                    UPDATE tracks
                    SET
                        path = ?,
                        fingerprint = ?,
                        modified = ?
                    WHERE path = ?
                    """,
                    (
                        str(
                            new_path.resolve()
                        ),
                        data["fingerprint"],
                        data["modified"],
                        str(
                            old_path.resolve()
                        ),
                    )
                )

                con.commit()

                con.close()

            except Exception as e:

                errors.append(
                    f"{old_path.name}: {e}"
                )

        # ----------------------------------------------------
        # Оновлюємо таблицю після rename
        # ----------------------------------------------------

        self.show_folder_tracks()

        # ----------------------------------------------------
        # RESULT
        # ----------------------------------------------------

        message = (
            f"Перейменовано файлів: {renamed}"
        )

        if errors:

            message += (
                "\n\nПомилки:\n"
                +
                "\n".join(errors)
            )

        QMessageBox.information(
            self,
            "Готово",
            message
        )


