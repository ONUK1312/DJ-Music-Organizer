# ============================================================
# DATABASE
# ============================================================

def db():
    con = sqlite3.connect(DB_FILE)

    con.execute("""
        CREATE TABLE IF NOT EXISTS libraries (
            id INTEGER PRIMARY KEY,
            path TEXT UNIQUE,
            name TEXT
        )
    """)

    con.execute("""
        CREATE TABLE IF NOT EXISTS tracks (
            id INTEGER PRIMARY KEY,
            path TEXT UNIQUE,
            fingerprint TEXT,
            artist TEXT,
            title TEXT,
            bpm TEXT,
            key TEXT,
            category TEXT,
            extension TEXT,
            modified REAL
        )
    """)

    columns = [
        x[1]
        for x in con.execute(
            "PRAGMA table_info(tracks)"
        ).fetchall()
    ]

    if "library_root" not in columns:
        con.execute(
            "ALTER TABLE tracks ADD COLUMN library_root TEXT"
        )

    if "relative_dir" not in columns:
        con.execute(
            "ALTER TABLE tracks ADD COLUMN relative_dir TEXT"
        )

    con.commit()

    return con


def clean_old_keys():
    try:
        con = sqlite3.connect(DB_FILE)

        valid = (
            "C", "C#", "D", "D#", "E", "F",
            "F#", "G", "G#", "A", "A#", "B",
            "Cm", "C#m", "Dm", "D#m", "Em", "Fm",
            "F#m", "Gm", "G#m", "Am", "A#m", "Bm"
        )

        placeholders = ",".join("?" for _ in valid)

        con.execute(
            f"UPDATE tracks SET key = '' "
            f"WHERE key IS NOT NULL "
            f"AND key NOT IN ({placeholders})",
            valid
        )

        con.commit()
        con.close()

    except Exception:
        pass


def get_track(path):
    con = db()

    row = con.execute(
        """
        SELECT *
        FROM tracks
        WHERE path = ?
        """,
        (str(path),)
    ).fetchone()

    con.close()

    return row


def save_track(data):
    con = db()

    con.execute("""
        INSERT INTO tracks
        (
            path,
            fingerprint,
            artist,
            title,
            bpm,
            key,
            category,
            extension,
            modified,
            library_root,
            relative_dir
        )
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)

        ON CONFLICT(path) DO UPDATE SET
            fingerprint=excluded.fingerprint,
            artist=excluded.artist,
            title=excluded.title,
            bpm=excluded.bpm,
            key=excluded.key,
            category=excluded.category,
            extension=excluded.extension,
            modified=excluded.modified,
            library_root=excluded.library_root,
            relative_dir=excluded.relative_dir
    """, (
        str(data["path"]),
        data["fingerprint"],
        data["artist"],
        data["title"],
        data["bpm"],
        data["key"],
        data["category"],
        data["extension"],
        data["modified"],
        str(data["library_root"]),
        data["relative_dir"],
    ))

    con.commit()
    con.close()


def save_library(root):
    con = db()

    con.execute("""
        INSERT INTO libraries(path, name)
        VALUES (?, ?)

        ON CONFLICT(path) DO UPDATE SET
            name=excluded.name
    """, (
        str(root),
        root.name or str(root),
    ))

    con.commit()
    con.close()


def get_libraries():
    con = db()

    rows = con.execute(
        """
        SELECT path, name
        FROM libraries
        ORDER BY name COLLATE NOCASE
        """
    ).fetchall()

    con.close()

    return rows


def get_library_root_for_path(path):
    """
    Визначає, до якої збереженої бібліотеки належить файл/папка.
    Повертає корінь бібліотеки або None.
    """

    path = Path(path).resolve()

    libraries = []

    for library_path, _name in get_libraries():

        root = Path(library_path).resolve()

        try:
            path.relative_to(root)
            libraries.append(root)
        except ValueError:
            continue

    if not libraries:
        return None

    # Якщо бібліотеки вкладені одна в одну,
    # беремо найбільш конкретну.
    libraries.sort(
        key=lambda x: len(x.parts),
        reverse=True
    )

    return libraries[0]


# ============================================================
# HELPERS
# ============================================================

def fingerprint(path):
    try:
        st = path.stat()

        return f"{st.st_size}:{st.st_mtime_ns}"

    except Exception:
        return ""


def clean_filename(text):
    for char in '<>:"/\\|?*':
        text = text.replace(char, "_")

    return " ".join(
        text.split()
    ).strip(" .")


def metadata(path):
    artist = ""
    title = ""

    try:
        audio = MutagenFile(
            path,
            easy=True
        )

        if audio:

            artist_values = audio.get(
                "artist",
                [""]
            )

            title_values = audio.get(
                "title",
                [""]
            )

            if artist_values:
                artist = str(
                    artist_values[0]
                )

            if title_values:
                title = str(
                    title_values[0]
                )

    except Exception:
        pass

    if not title:
        title = path.stem

    if not artist:
        artist = "Unknown Artist"

    return artist, title


# ============================================================
# BPM
# ============================================================

def detect_bpm(path):

    try:

        source = aubio.source(
            str(path),
            0,
            512
        )

        tempo = aubio.tempo(
            "default",
            1024,
            512,
            source.samplerate
        )

        values = []

        while True:

            samples, read = source()

            if tempo(samples):

                bpm = float(
                    tempo.get_bpm()
                )

                if 50 <= bpm <= 220:
                    values.append(bpm)

            if read < 512:
                break

        if not values:
            return ""

        return str(
            round(
                sum(values) / len(values)
            )
        )

    except Exception:
        return ""


# ============================================================
# KEY
# ============================================================

def detect_key(path):
    try:
        result = subprocess.run(
            ["keyfinder-cli", str(path)],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=180
        )

        valid_major = {
            "C", "C#", "D", "D#", "E", "F",
            "F#", "G", "G#", "A", "A#", "B"
        }

        valid_minor = {
            "Cm", "C#m", "Dm", "D#m", "Em", "Fm",
            "F#m", "Gm", "G#m", "Am", "A#m", "Bm"
        }

        flats = {
            "Ab": "G#",
            "Bb": "A#",
            "Cb": "B",
            "Db": "C#",
            "Eb": "D#",
            "Fb": "E",
            "Gb": "F#",
            "Abm": "G#m",
            "Bbm": "A#m",
            "Cbm": "Bm",
            "Dbm": "C#m",
            "Ebm": "D#m",
            "Fbm": "Em",
            "Gbm": "F#m",
        }

        valid_keys = valid_major | valid_minor

        for line in result.stdout.splitlines():
            key = line.strip()

            if not key:
                continue

            if re.fullmatch(r"\d{1,2}[ABab]", key):
                continue

            key = re.sub(
                r"\s+(minor|Minor|MINOR)$",
                "m",
                key
            )

            key = key.replace(" ", "")

            if key in flats:
                return flats[key]

            if key in valid_keys:
                return key

        return ""

    except Exception as e:
        print(f"Помилка визначення тональності {path}: {e}")
        return ""


def find_audio_files(folder):
    """
    Повертає ТІЛЬКИ реально існуючі аудіофайли.
    SQLite тут взагалі не використовується.
    """

    folder = Path(folder)

    if not folder.exists():
        return []

    if not folder.is_dir():
        return []

    files = []

    try:

        for path in folder.rglob("*"):

            try:
                if (
                    path.is_file()
                    and path.suffix.lower()
                    in AUDIO_EXTENSIONS
                ):
                    files.append(
                        path.resolve()
                    )

            except Exception:
                continue

    except Exception:
        return []

    return sorted(
        files,
        key=lambda x: str(x).lower()
    )


# ============================================================
# ANALYZER
# ============================================================

class Analyzer(QThread):

    progress = Signal(int)
    track = Signal(dict)
    finished_all = Signal()

    def __init__(self, library_root, files, force=False):
        super().__init__()
        self.library_root = Path(library_root).resolve()
        self.files = [Path(x).resolve() for x in files]
        self.force = force

    def run(self):
        total = len(self.files)

        if total == 0:
            self.progress.emit(100)
            self.finished_all.emit()
            return

        valid_keys = {
            "C", "C#", "D", "D#", "E", "F",
            "F#", "G", "G#", "A", "A#", "B"
        }

        for index, path in enumerate(self.files):

            if not path.exists():
                self.progress.emit(int((index + 1) * 100 / total))
                continue

            try:
                fp = fingerprint(path)
                saved = get_track(path)

                try:
                    relative_dir = path.parent.relative_to(self.library_root)
                    category = (
                        relative_dir.parts[0]
                        if relative_dir.parts
                        else self.library_root.name
                    )
                except ValueError:
                    relative_dir = Path(".")
                    category = self.library_root.name

                # Кеш використовуємо ТІЛЬКИ якщо BPM і Key вже є.
                use_cache = (
                    not self.force
                    and saved
                    and saved[2] == fp
                    and saved[10] == str(self.library_root)
                    and saved[5] is not None
                    and float(saved[5] or 0) > 0
                    and saved[6] in valid_keys
                )

                if use_cache:

                    data = {
                        "path": str(path),
                        "fingerprint": fp,
                        "artist": saved[3] or "Unknown Artist",
                        "title": saved[4] or path.stem,
                        "bpm": saved[5],
                        "key": saved[6],
                        "category": saved[7] or category,
                        "extension": saved[8] or path.suffix.lower(),
                        "modified": path.stat().st_mtime,
                        "library_root": str(self.library_root),
                        "relative_dir": str(relative_dir),
                    }

                else:

                    print(f"Аналіз: {path.name}")

                    artist, title = metadata(path)

                    # BPM
                    bpm = 0
                    try:
                        bpm = detect_bpm(path)
                        print(f"  BPM: {bpm}")
                    except Exception as e:
                        print(f"  BPM ПОМИЛКА: {e}")

                    # KEY
                    key = ""
                    try:
                        key = detect_key(path)
                        print(f"  KEY: {key if key else 'не визначено'}")
                    except Exception as e:
                        print(f"  KEY ПОМИЛКА: {e}")

                    if key not in valid_keys:
                        key = ""

                    data = {
                        "path": str(path),
                        "fingerprint": fp,
                        "artist": artist,
                        "title": title,
                        "bpm": bpm,
                        "key": key,
                        "category": category,
                        "extension": path.suffix.lower(),
                        "modified": path.stat().st_mtime,
                        "library_root": str(self.library_root),
                        "relative_dir": str(relative_dir),
                    }

                    save_track(data)

                # Передаємо РЕЗУЛЬТАТ саме цього треку в GUI
                self.track.emit(data)

            except Exception as e:
                print(f"ПОМИЛКА ФАЙЛУ: {path}")
                print(f"  {e}")

            self.progress.emit(int((index + 1) * 100 / total))

        self.finished_all.emit()


